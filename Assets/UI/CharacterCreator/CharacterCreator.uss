/* The character creator (ui-2). The left side is empty so the preview critter in the scene shows through. */

.creator {
    flex-grow: 1;
    flex-direction: row;
}

.creator__stage {
    flex-grow: 1;
}

.creator__panel {
    width: 200px;
    margin: 12px 16px 12px 0;
    padding: 8px;
    justify-content: center;
    background-color: var(--bb-panel);
    border-width: 1px;
    border-color: var(--bb-edge);
    border-radius: 3px;
}

.creator__title {
    margin: 0 0 6px 4px;
    padding: 0;
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--bb-ink);
}

.creator__name-row {
    flex-direction: row;
    align-items: center;
    height: 14px;
    margin-bottom: 4px;
    padding-left: 4px;
    padding-right: 2px;
}

/* The rows scroll, a section at a time, and the focused row scrolls into view. */
.creator__rows {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.creator__rows .unity-scroller--vertical {
    width: 3px;
}

.creator__rows .unity-scroller--vertical .unity-base-slider__dragger {
    width: 3px;
    background-color: var(--bb-edge);
    border-width: 0;
}

.creator__rows .unity-scroller--vertical .unity-base-slider__tracker,
.creator__rows .unity-scroller--vertical .unity-repeat-button {
    display: none;
}

.creator__section {
    margin: 4px 0 1px 4px;
    padding: 0;
    font-size: 7px;
    -unity-font-style: bold;
    color: var(--bb-ink-muted);
}

.creator__name {
    width: 96px;
    margin: 0;
    padding: 0;
}

.creator__name .unity-text-field__input,
.creator__name .unity-base-text-field__input {
    height: 12px;
    margin: 0;
    padding: 0 3px;
    font-size: 8px;
    color: var(--bb-ink);
    background-color: var(--bb-button);
    border-width: 1px;
    border-color: var(--bb-edge);
    border-radius: 2px;
}

.creator__name:focus .unity-text-field__input,
.creator__name:focus .unity-base-text-field__input {
    border-color: var(--bb-focus);
}

.creator__hint {
    margin: 4px 0 0 4px;
    padding: 0;
    font-size: 6px;
    white-space: normal;
    -unity-font-style: italic;
    color: var(--bb-ink-muted);
}

.creator__begin {
    height: 16px;
    margin: 6px 0 0 0;
    font-size: 9px;
    color: var(--bb-ink);
    background-color: var(--bb-go);
    border-width: 1px;
    border-color: var(--bb-edge);
    border-radius: 2px;
}

.creator__begin:hover {
    background-color: var(--bb-go-hover);
}

.creator__begin:focus {
    border-color: var(--bb-focus);
}

.creator__begin:disabled {
    color: var(--bb-ink-muted);
    background-color: var(--bb-off);
}
